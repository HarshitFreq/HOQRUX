{
  "expo": {
    "name": "Hoqrux",
    "slug": "hoqrux",
    "scheme": "hoqrux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#050507",
    "description": "Swiss Brutalist Personal Media Radar & Film Tracker",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harshit.hoqrux",
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.harshit.hoqrux",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "./plugins/withDynamicAndroidIcon.js"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d5fcdf8e-6146-4b31-b8a4-cb65c909a943"
      }
    },
    "owner": "harshitchronicles"
  }
}
